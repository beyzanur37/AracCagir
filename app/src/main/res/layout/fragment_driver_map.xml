<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f5f5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Sürücü Paneli"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#ff9800"
        android:textColor="#ffffff" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabNavigation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:src="@android:drawable/ic_menu_directions"
            android:backgroundTint="#ffffff"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/llRideRequest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#ffffff"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yeni Yolcu İsteği!"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#d32f2f"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvPassengerInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yolcu sizi çağırıyor..."
            android:textSize="16sp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            
            <Button
                android:id="@+id/btnReject"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="55dp"
                android:text="Reddet"
                android:backgroundTint="#d32f2f"
                android:layout_marginEnd="8dp"/>
                
            <Button
                android:id="@+id/btnAccept"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="55dp"
                android:text="Kabul Et"
                android:backgroundTint="#4CAF50"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btnFinishRide"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="SÜRÜŞÜ BİTİR VE ÖDEME AL"
        android:backgroundTint="#000000"
        android:textColor="#ffffff"
        android:textStyle="bold"
        android:layout_margin="16dp"
        android:visibility="gone" />
</LinearLayout>
