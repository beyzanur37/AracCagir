<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#f8f9fa">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Adım 3: Araç Bilgileri"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#343a40"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="30dp"/>

    <EditText
        android:id="@+id/etPlate"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Araç Plakası (Örn: 34 ABC 123)"
        android:inputType="textCapCharacters"
        android:background="#ffffff"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:elevation="2dp" />

    <EditText
        android:id="@+id/etModel"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Araç Marka / Model"
        android:inputType="textCapWords"
        android:background="#ffffff"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:elevation="2dp" />
        
    <EditText
        android:id="@+id/etColor"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Araç Rengi"
        android:inputType="textCapWords"
        android:background="#ffffff"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:elevation="2dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Araç Tipi Seçiniz"
        android:textColor="#343a40"
        android:layout_marginBottom="8dp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spVehicleType"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="#ffffff"
        android:layout_marginBottom="32dp"
        android:elevation="2dp" />

    <Button
        android:id="@+id/btnContinueVehicle"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Devam Et"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#000000"
        android:textColor="#ffffff" />
</LinearLayout>
